# Generate each secret independently: openssl rand -hex 32
WAHA_API_KEY=
WEBHOOK_SECRET=
WAHA_SESSION=default
WAHA_PORT=3010
# Set these to absolute paths on Unraid:
# BOT_DATA_DIR=/mnt/user/appdata/verbier-bot
# WAHA_DATA_DIR=/mnt/user/appdata/verbier-waha
# For production, pin the published seven-character Git commit tag:
# BOT_IMAGE_TAG=

# Optional: keep reports and command replies paused until this instant.
# BOT_START_AT=2026-11-15T08:00:00+01:00
